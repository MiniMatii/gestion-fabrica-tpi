+﻿@* Materia prima y lotes consumidos por una orden de producción *@
+@if (Consumos.Count == 0)
+{
+    <p class="text-muted small mt-2 mb-0">Esta orden no tiene consumos de lote registrados.</p>
+}
+else
+{
+    <div class="tabla-wrap mt-2">
+        <table class="table table-sm align-middle mb-0">
+            <thead>
+                <tr>
+                    <th>Materia prima</th>
+                    <th>Lote</th>
+                    <th class="text-end">Cantidad usada</th>
+                    <th>Ingreso</th>
+                    <th>Vencimiento</th>
+                    <th>Proveedor</th>
+                </tr>
+            </thead>
+            <tbody>
+                @foreach (var c in Consumos)
+                {
+                    <tr>
+                        <td class="fw-semibold">@c.MateriaPrima</td>
+                        <td>#@c.IdLote</td>
+                        <td class="text-end">@c.CantConsumida.ToString("0.##") @c.Unidad</td>
+                        <td>@c.FechaIngreso.ToString("dd/MM/yyyy")</td>
+                        <td>@c.FechaVencimiento.ToString("dd/MM/yyyy")</td>
+                        <td>@(string.IsNullOrWhiteSpace(c.Proveedor) ? "—" : c.Proveedor)</td>
+                    </tr>
+                }
+            </tbody>
+        </table>
+    </div>
+}
+
+@code {
+    [Parameter] public List<TrazaConsumoFila> Consumos { get; set; } = new();
+}
diff --git a/Alemana.Web/Components/Pages/Trazabilidad.razor b/Alemana.Web/Components/Pages/Trazabilidad.razor
new file mode 100644
index 0000000..5ee5ad7
--- /dev/null
+++ b/Alemana.Web/Components/Pages/Trazabilidad.razor
@@ -0,0 +1,251 @@
+﻿@page "/trazabilidad"
+@attribute [Authorize]
+@inject ApiClient Api
+
+<PageTitle>Trazabilidad - Alemana</PageTitle>
+
+<div class="page-header">
+    <div>
+        <h2 class="page-title">Control de trazabilidad</h2>
+        <p class="page-subtitle">
+            Ante un defecto: de qué producción salió lo despachado en un pedido y qué materia prima (con sus lotes) se usó,
+            o a qué pedidos pudo ir lo producido por una orden.
+        </p>
+    </div>
+</div>
+
+@if (!string.IsNullOrEmpty(mensaje))
+{
+    <div class="alert alert-danger" role="alert">
+        <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensaje
+    </div>
+}
+
+<div class="card mb-4 filtros">
+    <div class="card-body p-3">
+        <form class="row g-2 align-items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
+            <div class="col-md-3">
+                <label class="form-label small text-muted" for="tz-modo">Buscar por</label>
+                <select id="tz-modo" class="form-select" @bind="modo">
+                    <option value="pedido">Pedido</option>
+                    <option value="orden">Orden de producción</option>
+                </select>
+            </div>
+            <div class="col-md-3">
+                <label class="form-label small text-muted" for="tz-numero">N° de @(modo == "pedido" ? "pedido" : "orden")</label>
+                <input id="tz-numero" type="number" min="1" class="form-control" @bind="numero" />
+            </div>
+            <div class="col-md-3">
+                <label class="form-label small text-muted" for="tz-dias">Ventana de producción (días)</label>
+                <input id="tz-dias" type="number" min="1" max="365" class="form-control" @bind="dias" />
+            </div>
+            <div class="col-md-3 d-flex gap-2">
+                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Buscar</button>
+            </div>
+        </form>
+        <div class="form-text mt-2">
+            Las órdenes de producción no están atadas a un pedido: el vínculo se arma por producto y fecha.
+            Se listan las órdenes finalizadas del producto hasta la fecha del despacho, dentro de la ventana indicada.
+        </div>
+    </div>
+</div>
+
+@if (cargando)
+{
+    <div class="empty-state">
+        <div class="spinner-border" role="status" aria-hidden="true"></div>
+        <p>Buscando...</p>
+    </div>
+}
+
+@if (porPedido is not null)
+{
+    <div class="card mb-4">
+        <div class="card-body p-4">
+            <h5 class="form-titulo">Pedido #@porPedido.IdPedido</h5>
+            <p class="mb-1">
+                <span class="pill pill-si">@porPedido.EstadoPedido</span>
+                Realizado el @porPedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
+            </p>
+            <p class="text-muted small mb-0">
+                Sucursal: @(string.IsNullOrWhiteSpace(porPedido.Sucursal) ? "—" : porPedido.Sucursal)
+                · Empleado: @(string.IsNullOrWhiteSpace(porPedido.Empleado) ? "—" : porPedido.Empleado)
+            </p>
+        </div>
+    </div>
+
+    <h5 class="form-titulo">Despachado</h5>
+    @if (porPedido.Despachos.Count == 0)
+    {
+        <div class="notice mb-4"><i class="bi bi-info-circle"></i> <span>Este pedido todavía no tiene despachos.</span></div>
+    }
+    else
+    {
+        <div class="tabla-wrap mb-4">
+            <table class="table align-middle">
+                <thead>
+                    <tr><th>Despacho</th><th>Fecha</th><th>Producto</th><th class="text-end">Cantidad</th></tr>
+                </thead>
+                <tbody>
+                    @foreach (var d in porPedido.Despachos)
+                    {
+                        <tr>
+                            <td class="text-muted">#@d.IdDespacho</td>
+                            <td>@d.FechaDespacho.ToString("dd/MM/yyyy HH:mm")</td>
+                            <td class="fw-semibold">@d.Producto</td>
+                            <td class="text-end">@d.Cantidad</td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        </div>
+
+        <h5 class="form-titulo">Producciones de origen posibles</h5>
+        @if (porPedido.Ordenes.Count == 0)
+        {
+            <div class="notice mb-4">
+                <i class="bi bi-info-circle"></i>
+                <span>No hay órdenes finalizadas de estos productos en la ventana de @porPedido.VentanaDias días anteriores al despacho.
+                      Probá ampliarla.</span>
+            </div>
+        }
+        else
+        {
+            @foreach (var g in porPedido.Ordenes.GroupBy(o => o.Producto))
+            {
+                <h6 class="mt-3">@g.Key</h6>
+                @foreach (var o in g)
+                {
+                    <div class="card mb-3">
+                        <div class="card-body p-3">
+                            <div class="d-flex flex-wrap gap-3 justify-content-between">
+                                <div>
+                                    <strong>Orden #@o.IdProd</strong>
+                                    <span class="text-muted ms-2">@o.CantidadAProducir unidades</span>
+                                </div>
+                                <div class="text-muted small">
+                                    Finalizada: @(o.FechaReal?.ToString("dd/MM/yyyy HH:mm") ?? "—")
+                                    · Operario: @(string.IsNullOrWhiteSpace(o.Operario) ? "—" : o.Operario)
+                                    · <a href="trazabilidad?orden=@o.IdProd">ver a qué pedidos fue</a>
+                                </div>
+                            </div>
+                            <TablaConsumos Consumos="@ConsumosDe(porPedido.Consumos, o.IdProd)" />
+                        </div>
+                    </div>
+                }
+            }
+        }
+    }
+}
+
+@if (porOrden is not null)
+{
+    <div class="card mb-4">
+        <div class="card-body p-4">
+            <h5 class="form-titulo">Orden de producción #@porOrden.Orden.IdProd</h5>
+            <p class="mb-1">
+                <strong>@porOrden.Orden.Producto</strong> · @porOrden.Orden.CantidadAProducir unidades
+                · <span class="pill @(porOrden.Orden.EstadoOrden == "Finalizada" ? "pill-si" : "pill-aviso")">@porOrden.Orden.EstadoOrden</span>
+            </p>
+            <p class="text-muted small mb-0">
+                Creada: @porOrden.Orden.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
+                · Finalizada: @(porOrden.Orden.FechaReal?.ToString("dd/MM/yyyy HH:mm") ?? "—")
+                · Operario: @(string.IsNullOrWhiteSpace(porOrden.Orden.Operario) ? "—" : porOrden.Orden.Operario)
+            </p>
+        </div>
+    </div>
+
+    <h5 class="form-titulo">Materia prima y lotes usados</h5>
+    <div class="mb-4">
+        <TablaConsumos Consumos="@porOrden.Consumos" />
+    </div>
+
+    <h5 class="form-titulo">Pedidos a los que pudo ir este producto</h5>
+    @if (porOrden.Despachos.Count == 0)
+    {
+        <div class="notice mb-4">
+            <i class="bi bi-info-circle"></i>
+            <span>@(porOrden.Orden.FechaReal is null
+                    ? "La orden todavía no finalizó."
+                    : $"No hay despachos de este producto en los {porOrden.VentanaDias} días posteriores a la finalización.")</span>
+        </div>
+    }
+    else
+    {
+        <div class="tabla-wrap mb-4">
+            <table class="table align-middle">
+                <thead>
+                    <tr><th>Pedido</th><th>Despacho</th><th>Fecha</th><th>Sucursal</th><th class="text-end">Cantidad</th></tr>
+                </thead>
+                <tbody>
+                    @foreach (var d in porOrden.Despachos)
+                    {
+                        <tr>
+                            <td><a href="trazabilidad?pedido=@d.IdPedido">#@d.IdPedido</a></td>
+                            <td class="text-muted">#@d.IdDespacho</td>
+                            <td>@d.FechaDespacho.ToString("dd/MM/yyyy HH:mm")</td>
+                            <td>@(string.IsNullOrWhiteSpace(d.Sucursal) ? "—" : d.Sucursal)</td>
+                            <td class="text-end">@d.Cantidad</td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        </div>
+    }
+}
+
+@code {
+    [SupplyParameterFromQuery(Name = "pedido")] public int? PedidoQuery { get; set; }
+    [SupplyParameterFromQuery(Name = "orden")] public int? OrdenQuery { get; set; }
+
+    private string modo = "pedido";
+    private int? numero;
+    private int dias = 30;
+    private bool cargando;
+    private string? mensaje;
+
+    private TrazabilidadPedidoDTO? porPedido;
+    private TrazabilidadOrdenDTO? porOrden;
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (PedidoQuery is int p) { modo = "pedido"; numero = p; await Buscar(); }
+        else if (OrdenQuery is int o) { modo = "orden"; numero = o; await Buscar(); }
+    }
+
+    private static List<TrazaConsumoFila> ConsumosDe(List<TrazaConsumoFila> todos, int idProd) =>
+        todos.Where(c => c.IdProd == idProd).ToList();
+
+    private async Task Buscar()
+    {
+        mensaje = null;
+        porPedido = null;
+        porOrden = null;
+
+        if (numero is null or <= 0)
+        {
+            mensaje = "Ingresá un número válido.";
+            return;
+        }
+
+        var ventana = Math.Clamp(dias, 1, 365);
+        cargando = true;
+        try
+        {
+            if (modo == "pedido")
+                porPedido = await Api.ObtenerAsync<TrazabilidadPedidoDTO>($"ado/trazabilidad/pedido/{numero}?dias={ventana}");
+            else
+                porOrden = await Api.ObtenerAsync<TrazabilidadOrdenDTO>($"ado/trazabilidad/orden/{numero}?dias={ventana}");
+        }
+        catch (Exception ex)
+        {
+            mensaje = ex.Message.Contains("NotFound")
+                ? $"No existe el {(modo == "pedido" ? "pedido" : "orden de producción")} #{numero}."
+                : "No se pudo consultar la trazabilidad: " + ex.Message;
+        }
+        finally
+        {
+            cargando = false;
+        }
+    }
+}
