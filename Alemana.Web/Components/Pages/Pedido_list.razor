@page "/pedidos"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Pedidos - Alemana</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Pedidos</h2>
        <p class="page-subtitle">Seguimiento de los pedidos, del más reciente al más antiguo.</p>
    </div>
    @if (pedidos is not null)
    {
        <span class="contador"><i class="bi bi-cart-fill"></i> @pedidos.Count resultado(s)</span>
    }
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensaje
    </div>
}

<div class="card mb-4 filtros">
    <div class="card-body p-3">
        <form class="row g-2 align-items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
            <div class="col-md-3">
                <label class="form-label small text-muted" for="ped-buscar">N° o empleado</label>
                <input id="ped-buscar" class="form-control" placeholder="Ej: 12 o Juan" @bind="filtroTexto" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted" for="ped-estado">Estado</label>
                <select id="ped-estado" class="form-select" @bind="filtroEstado">
                    <option value="">Todos</option>
                    <option value="pendientes">Pendientes</option>
                    <option value="entregados">Entregados</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted" for="ped-desde">Desde</label>
                <input id="ped-desde" type="date" class="form-control" @bind="filtroDesde" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted" for="ped-hasta">Hasta</label>
                <input id="ped-hasta" type="date" class="form-control" @bind="filtroHasta" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Buscar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar"><i class="bi bi-x-lg"></i> Limpiar</button>
            </div>
        </form>
    </div>
</div>

@if (pedidos is null)
{
    <div class="empty-state">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <p>Cargando pedidos...</p>
    </div>
}
else if (!pedidos.Any())
{
    <div class="empty-state">
        <i class="bi bi-cart"></i>
        <p>@(HayFiltros ? "No hay pedidos que coincidan con los filtros." : "Todavía no hay pedidos registrados.")</p>
    </div>
}
else
{
    <div class="tabla-wrap">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 5rem;">N°</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Entrega estimada</th>
                    <th>Entrega real</th>
                    <th>Empleado</th>
                    <th class="text-end">Ítems</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in pedidos)
                {
                    <tr>
                        <td class="text-muted">@p.IdPedido</td>
                        <td class="fw-semibold">@Fecha(p.FechaPedido)</td>
                        <td>
                            <span class="pill @(p.FechaReal is null ? "pill-aviso" : "pill-si")">@p.EstadoPedido</span>
                        </td>
                        <td>@Fecha(p.FechaEstimada)</td>
                        <td>@Fecha(p.FechaReal)</td>
                        <td>@(string.IsNullOrWhiteSpace(p.Empleado) ? $"#{p.IdEmpleado}" : p.Empleado)</td>
                        <td class="text-end">@p.CantItems</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<PedidoFila>? pedidos;
    private string? mensaje;

    private string filtroTexto = "";
    private string filtroEstado = "";
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(filtroTexto) || !string.IsNullOrEmpty(filtroEstado)
        || filtroDesde is not null || filtroHasta is not null;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            mensaje = null;
            pedidos = await Api.ObtenerListaAsync<PedidoFila>(QueryString.Crear("ado/pedidos",
                ("texto", filtroTexto), ("estado", string.IsNullOrEmpty(filtroEstado) ? null : filtroEstado),
                ("desde", filtroDesde), ("hasta", filtroHasta))) ?? new();
        }
        catch (Exception ex)
        {
            pedidos = new();
            mensaje = ex.Message;
        }
    }

    private async Task Buscar() => await Cargar();

    private async Task Limpiar()
    {
        filtroTexto = "";
        filtroEstado = "";
        filtroDesde = null;
        filtroHasta = null;
        await Cargar();
    }

    private static string Fecha(DateTime? fecha) =>
        fecha?.ToString("dd/MM/yyyy") ?? "—";
}
