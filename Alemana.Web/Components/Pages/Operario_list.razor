@page "/operarios"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Operarios - Alemana</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Operarios</h2>
        <p class="page-subtitle">Cargá y consultá al personal de producción.</p>
    </div>
    @if (operarios is not null)
    {
        <span class="contador"><i class="bi bi-people-fill"></i> @operarios.Count resultado(s)</span>
    }
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(exito ? "alert-success" : "alert-danger")" role="alert">
        <i class="bi @(exito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>@mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body p-4">
        <h5 class="form-titulo">Nuevo operario</h5>

        <EditForm Model="nuevo" OnValidSubmit="Guardar">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="op-nombre">Nombre</label>
                    <InputText id="op-nombre" class="form-control" @bind-Value="nuevo.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="op-apellido">Apellido</label>
                    <InputText id="op-apellido" class="form-control" @bind-Value="nuevo.Apellido" />
                </div>
                <div class="col-md-2">
                    <div class="form-check form-switch pb-2">
                        <InputCheckbox id="op-disponible" class="form-check-input" @bind-Value="disponible" />
                        <label class="form-check-label" for="op-disponible">Disponible</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg me-1"></i> Agregar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="card mb-4 filtros">
    <div class="card-body p-3">
        <form class="row g-2 align-items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
            <div class="col-md-5">
                <label class="form-label small text-muted" for="op-buscar">Buscar por nombre o apellido</label>
                <input id="op-buscar" class="form-control" placeholder="Ej: Gómez" @bind="filtroTexto" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted" for="op-filtro-disp">Disponibilidad</label>
                <select id="op-filtro-disp" class="form-select" @bind="filtroDisp">
                    <option value="">Todos</option>
                    <option value="1">Disponible</option>
                    <option value="0">No disponible</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Buscar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar"><i class="bi bi-x-lg"></i> Limpiar</button>
            </div>
        </form>
    </div>
</div>

@if (operarios is null)
{
    <div class="empty-state">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <p>Cargando operarios...</p>
    </div>
}
else if (!operarios.Any())
{
    <div class="empty-state">
        <i class="bi bi-person-plus"></i>
        <p>@(HayFiltros ? "No hay operarios que coincidan con los filtros." : "Todavía no hay operarios. Agregá el primero con el formulario de arriba.")</p>
    </div>
}
else
{
    <div class="tabla-wrap">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 5rem;">Id</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in operarios)
                {
                    <tr>
                        <td class="text-muted">@o.IdOperario</td>
                        <td class="fw-semibold">@o.Nombre</td>
                        <td>@o.Apellido</td>
                        <td>
                            @if (o.Disponibilidad == 1)
                            {
                                <span class="pill pill-si">Disponible</span>
                            }
                            else
                            {
                                <span class="pill pill-no">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<OperarioFila>? operarios;
    private OperariosDTO nuevo = new();
    private string? mensaje;
    private bool exito;
    private bool disponible = true;

    private string filtroTexto = "";
    private string filtroDisp = "";

    private bool HayFiltros => !string.IsNullOrWhiteSpace(filtroTexto) || !string.IsNullOrEmpty(filtroDisp);

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            operarios = await Api.ObtenerListaAsync<OperarioFila>(QueryString.Crear("ado/operarios",
                ("texto", filtroTexto), ("disponibilidad", ParseDisp(filtroDisp)))) ?? new();
        }
        catch (Exception ex)
        {
            operarios = new();
            mensaje = ex.Message;
            exito = false;
        }
    }

    private async Task Buscar() => await Cargar();

    private async Task Limpiar()
    {
        filtroTexto = "";
        filtroDisp = "";
        await Cargar();
    }

    private static int? ParseDisp(string valor) => valor switch
    {
        "1" => 1,
        "0" => 0,
        _ => (int?)null
    };

    private async Task Guardar()
    {
        mensaje = null;
        nuevo.Disponibilidad = (sbyte)(disponible ? 1 : 0);

        if (string.IsNullOrWhiteSpace(nuevo.Nombre) || string.IsNullOrWhiteSpace(nuevo.Apellido))
        {
            mensaje = "Nombre y apellido son obligatorios.";
            exito = false;
            return;
        }

        try
        {
            var ok = await Api.PostAsync("operario/", nuevo);
            if (!ok) throw new InvalidOperationException("La API no pudo guardar el operario.");
            mensaje = "Operario creado.";
            exito = true;
            nuevo = new();
            disponible = true;
            await Cargar();
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo guardar el operario: {ex.Message}";
            exito = false;
        }
    }
}
