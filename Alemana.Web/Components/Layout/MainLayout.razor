@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener" class="help-link">
                        <i class="bi bi-question-circle"></i> Ayuda y soporte
                    </a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>

    <NotAuthorized>
        @* Sin sesión: solo se muestra la página (login), sin menú lateral *@
        <main class="login-shell">
            @Body
        </main>
    </NotAuthorized>

    <Authorizing>
        <div class="login-shell">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
        </div>
    </Authorizing>
</AuthorizeView>

<div id="blazor-error-ui">
    Ha ocurrido un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
