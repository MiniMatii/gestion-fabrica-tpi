+﻿@page "/reportes"
+@attribute [Authorize]
+@inject ApiClient Api
+
+<PageTitle>Reportes - Alemana</PageTitle>
+
+<div class="page-header">
+    <div>
+        <h2 class="page-title">Reportes</h2>
+        <p class="page-subtitle">Reportes estadísticos de la fábrica.</p>
+    </div>
+</div>
+
+@if (!string.IsNullOrEmpty(mensaje))
+{
+    <div class="alert alert-danger" role="alert">
+        <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensaje
+    </div>
+}
+
+<ul class="nav nav-pills mb-3">
+    <li class="nav-item">
+        <button type="button" class="nav-link @(reporte == "lotes" ? "active" : "")" @onclick='() => reporte = "lotes"'>
+            Lotes por producto de pedido
+        </button>
+    </li>
+</ul>
+
+@if (reporte == "lotes")
+{
+    <div class="card mb-4 filtros">
+        <div class="card-body p-3">
+            <form class="row g-2 align-items-end" @onsubmit="Generar" @onsubmit:preventDefault>
+                <div class="col-md-2">
+                    <label class="form-label small text-muted" for="rp-pedido">N° de pedido</label>
+                    <input id="rp-pedido" type="number" min="1" class="form-control" @bind="fPedido" />
+                </div>
+                <div class="col-md-3">
+                    <label class="form-label small text-muted" for="rp-producto">Producto</label>
+                    <input id="rp-producto" class="form-control" placeholder="Ej: medialuna" @bind="fProducto" />
+                </div>
+                <div class="col-md-2">
+                    <label class="form-label small text-muted" for="rp-desde">Pedidos desde</label>
+                    <input id="rp-desde" type="date" class="form-control" @bind="fDesde" />
+                </div>
+                <div class="col-md-2">
+                    <label class="form-label small text-muted" for="rp-hasta">Pedidos hasta</label>
+                    <input id="rp-hasta" type="date" class="form-control" @bind="fHasta" />
+                </div>
+                <div class="col-md-1">
+                    <label class="form-label small text-muted" for="rp-dias">Ventana (días)</label>
+                    <input id="rp-dias" type="number" min="1" max="365" class="form-control" @bind="fDias" />
+                </div>
+                <div class="col-md-2 d-flex gap-2">
+                    <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Generar</button>
+                    <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar"><i class="bi bi-x-lg"></i></button>
+                </div>
+            </form>
+            <div class="form-text mt-2">
+                De cada producto despachado, se indican los lotes de materia prima de las órdenes de producción finalizadas de ese
+                producto hasta el último despacho, dentro de la ventana. Las órdenes no están atadas a pedidos, por eso es por producto y fecha.
+            </div>
+        </div>
+    </div>
+
+    @if (cargando)
+    {
+        <div class="empty-state">
+            <div class="spinner-border" role="status" aria-hidden="true"></div>
+            <p>Generando reporte...</p>
+        </div>
+    }
+    else if (filas is null)
+    {
+        <div class="empty-state">
+            <i class="bi bi-bar-chart-line"></i>
+            <p>Elegí los filtros y generá el reporte.</p>
+        </div>
+    }
+    else if (filas.Count == 0)
+    {
+        <div class="empty-state">
+            <i class="bi bi-inbox"></i>
+            <p>No hay pedidos despachados que coincidan con los filtros.</p>
+        </div>
+    }
+    else
+    {
+        <div class="row g-3 mb-4">
+            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-3">
+                <div class="text-muted small">Pedidos</div><div class="fs-4 fw-bold">@filas.Select(f => f.IdPedido).Distinct().Count()</div>
+            </div></div></div>
+            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-3">
+                <div class="text-muted small">Productos despachados</div><div class="fs-4 fw-bold">@filas.Select(f => (f.IdPedido, f.IdProducto)).Distinct().Count()</div>
+            </div></div></div>
+            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-3">
+                <div class="text-muted small">Órdenes de origen</div><div class="fs-4 fw-bold">@filas.Where(f => f.IdProd is not null).Select(f => f.IdProd).Distinct().Count()</div>
+            </div></div></div>
+            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-3">
+                <div class="text-muted small">Lotes involucrados</div><div class="fs-4 fw-bold">@filas.Where(f => f.IdLote is not null).Select(f => f.IdLote).Distinct().Count()</div>
+            </div></div></div>
+        </div>
+
+        @foreach (var pedido in filas.GroupBy(f => f.IdPedido))
+        {
+            <div class="card mb-3">
+                <div class="card-body p-3">
+                    <div class="d-flex justify-content-between align-items-center mb-2">
+                        <h5 class="form-titulo mb-0">Pedido #@pedido.Key</h5>
+                        <span class="text-muted small">
+                            @pedido.First().FechaPedido.ToString("dd/MM/yyyy")
+                            · <a href="trazabilidad?pedido=@pedido.Key">ver trazabilidad</a>
+                        </span>
+                    </div>
+
+                    @foreach (var prod in pedido.GroupBy(f => f.IdProducto))
+                    {
+                        var primero = prod.First();
+                        <h6 class="mt-3 mb-1">@primero.Producto <span class="text-muted fw-normal">· @primero.CantidadDespachada despachadas</span></h6>
+
+                        @if (prod.All(f => f.IdLote is null))
+                        {
+                            <p class="text-muted small mb-2">Sin producción finalizada registrada en la ventana de @fDias días.</p>
+                        }
+                        else
+                        {
+                            <div class="tabla-wrap">
+                                <table class="table table-sm align-middle mb-0">
+                                    <thead>
+                                        <tr>
+                                            <th>Orden</th>
+                                            <th>Materia prima</th>
+                                            <th>Lote</th>
+                                            <th class="text-end">Usado</th>
+                                            <th>Vencimiento</th>
+                                            <th>Proveedor</th>
+                                        </tr>
+                                    </thead>
+                                    <tbody>
+                                        @foreach (var f in prod.Where(x => x.IdLote is not null))
+                                        {
+                                            <tr>
+                                                <td>#@f.IdProd <span class="text-muted small">@f.FechaOrden?.ToString("dd/MM")</span></td>
+                                                <td class="fw-semibold">@f.MateriaPrima</td>
+                                                <td>#@f.IdLote</td>
+                                                <td class="text-end">@f.CantidadUsada?.ToString("0.##") @f.Unidad</td>
+                                                <td>@f.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
+                                                <td>@(string.IsNullOrWhiteSpace(f.Proveedor) ? "—" : f.Proveedor)</td>
+                                            </tr>
+                                        }
+                                    </tbody>
+                                </table>
+                            </div>
+                        }
+                    }
+                </div>
+            </div>
+        }
+
+        <h5 class="form-titulo mt-4">Lotes involucrados</h5>
+        <div class="tabla-wrap mb-4">
+            <table class="table align-middle">
+                <thead>
+                    <tr>
+                        <th>Lote</th>
+                        <th>Materia prima</th>
+                        <th>Proveedor</th>
+                        <th class="text-end">Pedidos alcanzados</th>
+                        <th class="text-end">Productos</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var l in filas.Where(f => f.IdLote is not null).GroupBy(f => f.IdLote).OrderByDescending(g => g.Select(x => x.IdPedido).Distinct().Count()))
+                    {
+                        var f0 = l.First();
+                        <tr>
+                            <td>#@l.Key</td>
+                            <td class="fw-semibold">@f0.MateriaPrima</td>
+                            <td>@(string.IsNullOrWhiteSpace(f0.Proveedor) ? "—" : f0.Proveedor)</td>
+                            <td class="text-end">@l.Select(x => x.IdPedido).Distinct().Count()</td>
+                            <td class="text-end">@l.Select(x => x.IdProducto).Distinct().Count()</td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        </div>
+    }
+}
+
+@code {
+    private string reporte = "lotes";
+    private int? fPedido;
+    private string fProducto = "";
+    private DateTime? fDesde;
+    private DateTime? fHasta;
+    private int fDias = 30;
+
+    private List<ReporteLoteProductoFila>? filas;
+    private bool cargando;
+    private string? mensaje;
+
+    private async Task Generar()
+    {
+        mensaje = null;
+        cargando = true;
+        try
+        {
+            filas = await Api.ObtenerListaAsync<ReporteLoteProductoFila>(QueryString.Crear("ado/reportes/lotes-por-producto",
+                ("pedido", fPedido),
+                ("producto", fProducto),
+                ("desde", fDesde),
+                ("hasta", fHasta),
+                ("dias", Math.Clamp(fDias, 1, 365)))) ?? new();
+        }
+        catch (Exception ex)
+        {
+            filas = null;
+            mensaje = "No se pudo generar el reporte: " + ex.Message;
+        }
+        finally
+        {
+            cargando = false;
+        }
+    }
+
+    private void Limpiar()
+    {
+        fPedido = null;
+        fProducto = "";
+        fDesde = null;
+        fHasta = null;
+        fDias = 30;
+        filas = null;
+    }
+}
